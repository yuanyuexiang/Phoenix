{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/contracts/extraction.schema.json",
  "title": "Phoenix evidence-backed extraction",
  "type": "object",
  "required": ["doc_type", "fields"],
  "properties": {
    "doc_type": { "type": "string", "minLength": 1 },
    "content_text": { "type": "string" },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "raw_text": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "region": { "type": "string" },
        "value_source": { "enum": ["document", "calculated", "manual"] },
        "formula": { "type": "string" },
        "notes": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "raw_text": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
