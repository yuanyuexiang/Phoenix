# Phoenix phoenix 生产环境配置模板。
# 复制到服务器 /opt/phoenix/.env 后填写,切勿提交真实值到仓库。

# --- 镜像来源(与 .github/workflows/deploy.yml 一致)---
REGISTRY=registry.cn-hangzhou.aliyuncs.com
REGISTRY_NAMESPACE=yuanyuexiang
# TAG 通常由部署命令注入(TAG=sha-xxxxxxx docker compose ...),不在此固定

# --- 机密(必填)---
POSTGRES_PASSWORD=phoenix
MINIO_ROOT_PASSWORD=phoenix
PHX_ADMIN_PASSWORD=phoenix    # 管理后台访问密码(/api 的 X-Access-Key)

# --- 可选覆盖 ---
POSTGRES_USER=phoenix
POSTGRES_DB=phoenix
MINIO_ROOT_USER=phoenix

# --- RAG 知识库 embedding(语义问答 ask_document;留空则知识库关闭)---
# 任何 OpenAI 兼容 embeddings 端点均可;模型输出维度须与迁移里的 vector(1024) 一致。
PHX_EMBED_ENDPOINT=
PHX_EMBED_API_KEY=
PHX_EMBED_MODEL=text-embedding-v3

# --- 员工级 REST 面 /pub/v1(自研账号 + JWT,phoenix-doc-assistant 专家用)---
# JWT 签名密钥:留空则 /pub/v1 不启用。生产设强随机长串(如 openssl rand -hex 32);
# 更换会使全部已登录员工失效。员工账号在管理后台「员工」页维护。
PHX_AUTH_SECRET=
